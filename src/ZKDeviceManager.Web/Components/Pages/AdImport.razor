@page "/directory"
@rendermode InteractiveServer
@inject AdDirectory Ad
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IConfiguration Config

<PageTitle>App access</PageTitle>

<h1 class="h3 mb-1">App access</h1>
<p class="text-muted small">
    The list below is the AD accounts allowed to sign in to this app. Search Active Directory and
    <strong>Grant access</strong> to add more.
    @if (!Config.GetValue("Auth:RestrictToGranted", false))
    {
        <span class="text-warning">Enforcement is currently OFF (anyone in the domain can still sign in) — ask me to turn it on once your list is ready.</span>
    }
</p>

@if (_flash is not null)
{
    <div class="alert alert-@_flashKind alert-dismissible">@_flash <button type="button" class="btn-close" @onclick="() => _flash = null"></button></div>
}

<div class="row g-2 mb-3 align-items-end">
    <div class="col-md-4"><label class="form-label mb-0 small">Search Active Directory — name / login / employee id</label>
        <input class="form-control form-control-sm" @bind="_term" @bind:event="oninput" @onkeyup="OnKey" placeholder="type a name then Search…" /></div>
    <div class="col-md-2"><button class="btn btn-primary btn-sm w-100" disabled="@_busy" @onclick="SearchAsync">
        <span class="bi bi-search"></span> Search AD</button></div>
    <div class="col-md-4">
        @if (_results is not null)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="wd" @bind="_onlyWithDept" />
                <label class="form-check-label small" for="wd">Only users with a department (hide service accounts)</label>
            </div>
        }
    </div>
</div>

@if (_busy) { <p><span class="spinner-border spinner-border-sm"></span> Querying directory…</p> }
else if (_results is not null)
{
    <div class="d-flex align-items-center gap-2 mb-2">
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _results = null"><span class="bi bi-arrow-left"></span> Back</button>
        <button class="btn btn-success btn-sm" disabled="@(_selected.Count == 0)" @onclick="GrantAsync">
            <span class="bi bi-key"></span> Grant access to selected (@_selected.Count)</button>
        <span class="text-muted small">@Filtered.Count() shown of @_results.Count · already-granted are marked.</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead><tr><th style="width:28px"><input type="checkbox" @onchange="ToggleAll" checked="@AllSel" /></th>
                <th>Name</th><th>Login</th><th>Employee id</th><th>Department</th><th>Title</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in Filtered)
                {
                    <tr>
                        <td><input type="checkbox" checked="@_selected.Contains(u.Login)" @onchange="e => Select(u.Login, (bool)e.Value!)" /></td>
                        <td class="fw-semibold">@u.Name</td>
                        <td class="small text-muted">@u.Login</td>
                        <td class="small">@(u.EmployeeId ?? "—")</td>
                        <td>@(u.Department ?? "—")</td>
                        <td class="small">@(u.Title ?? "—")</td>
                        <td>@if (_granted.ContainsKey(u.Login.ToLowerInvariant())) { <span class="badge bg-secondary">has access</span> }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <h2 class="h6 mb-2"><span class="bi bi-people-fill"></span> Users with app access <span class="text-muted">(@_granted.Count)</span></h2>
    @if (_granted.Count == 0)
    {
        <div class="alert alert-info">No users granted yet. Search Active Directory above and <strong>Grant access</strong>.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle" style="max-width:720px">
                <thead><tr><th>Login</th><th>Name</th><th>Granted</th><th class="text-end"></th></tr></thead>
                <tbody>
                    @foreach (var a in _granted.Values.OrderBy(a => a.Name))
                    {
                        <tr>
                            <td class="fw-semibold">@a.Login</td>
                            <td>@a.Name</td>
                            <td class="small text-muted">@a.When.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td class="text-end"><button class="btn btn-sm btn-outline-danger" title="Remove access" @onclick="() => RemoveAsync(a.Id)"><span class="bi bi-x-lg"></span></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private record Granted(int Id, string Login, string Name, DateTime When);

    private string _term = "";
    private List<AdDirectory.AdUser>? _results;
    private Dictionary<string, Granted> _granted = new();   // key = login (lower)
    private readonly HashSet<string> _selected = new();
    private bool _busy;
    private bool _onlyWithDept = true;
    private string? _flash;
    private string _flashKind = "success";

    protected override async Task OnInitializedAsync() => await LoadGrantedAsync();

    private async Task LoadGrantedAsync()
    {
        try
        {
            await using var db = DbFactory.CreateDbContext();
            _granted = (await db.AppAccessUsers.ToListAsync())
                .ToDictionary(a => a.Login, a => new Granted(a.Id, a.Login, a.DisplayName ?? a.Login, a.GrantedUtc));
        }
        catch (Exception ex) { _flash = "Could not load access list: " + ex.Message; _flashKind = "danger"; }
    }

    private IEnumerable<AdDirectory.AdUser> Filtered =>
        _results is null ? Enumerable.Empty<AdDirectory.AdUser>()
        : _onlyWithDept ? _results.Where(u => !string.IsNullOrWhiteSpace(u.Department))
        : _results;

    private bool AllSel => Filtered.Any() && Filtered.All(u => _selected.Contains(u.Login));
    private static string Cap(string s, int max) => s.Length <= max ? s : s[..max];

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await SearchAsync(); }

    private async Task SearchAsync()
    {
        _busy = true; _flash = null; _selected.Clear();
        try { _results = await Task.Run(() => Ad.Search(_term)); }
        catch (Exception ex) { _flash = "Directory error: " + ex.Message; _flashKind = "danger"; _results = null; }
        finally { _busy = false; }
    }

    private void Select(string login, bool on) { if (on) _selected.Add(login); else _selected.Remove(login); }
    private void ToggleAll(ChangeEventArgs e) { var on = (bool)e.Value!;
        foreach (var u in Filtered) { if (on) _selected.Add(u.Login); else _selected.Remove(u.Login); } }

    private async Task GrantAsync()
    {
        int granted = 0, empNew = 0;
        await using var db = DbFactory.CreateDbContext();
        var depByName = await db.Departments.ToDictionaryAsync(d => d.Name.ToLower(), d => d);

        foreach (var login in _selected.ToList())
        {
            var u = _results!.First(x => x.Login == login);
            var loginKey = u.Login.Trim().ToLowerInvariant();
            if (string.IsNullOrWhiteSpace(loginKey)) continue;

            // 1) grant sign-in access
            var acc = await db.AppAccessUsers.FirstOrDefaultAsync(a => a.Login == loginKey);
            if (acc is null) { acc = new AppAccessUser { Login = loginKey }; db.AppAccessUsers.Add(acc); granted++; }
            acc.DisplayName = Cap(u.Name, 100);

            // 2) also add them as an employee so they appear in the directory
            var pin = string.IsNullOrWhiteSpace(u.EmployeeId) ? u.Login : u.EmployeeId!.Trim();
            if (pin.Length <= 24)
            {
                int? depId = null;
                if (!string.IsNullOrWhiteSpace(u.Department))
                {
                    var dkey = Cap(u.Department, 100).ToLower();
                    if (!depByName.TryGetValue(dkey, out var dep))
                    { dep = new Department { Name = Cap(u.Department, 100) }; db.Departments.Add(dep); await db.SaveChangesAsync(); depByName[dkey] = dep; }
                    depId = dep.Id;
                }
                var e = await db.Employees.FirstOrDefaultAsync(x => x.Pin == pin);
                if (e is null) { e = new Employee { Pin = pin }; db.Employees.Add(e); empNew++; }
                if (!string.IsNullOrWhiteSpace(u.Name)) e.FullName = Cap(u.Name, 100);
                if (!string.IsNullOrWhiteSpace(u.Title)) e.JobTitle = Cap(u.Title, 100);
                if (depId is not null) e.DepartmentId = depId;
                e.Active = true; e.UpdatedUtc = DateTime.UtcNow;
                if (!string.IsNullOrWhiteSpace(u.Name))
                {
                    var p = await db.UserProfiles.FirstOrDefaultAsync(x => x.Pin == pin);
                    if (p is null) { p = new UserProfile { Pin = pin }; db.UserProfiles.Add(p); }
                    p.DisplayName = Cap(u.Name, 50); p.UpdatedUtc = DateTime.UtcNow;
                }
            }
            await db.SaveChangesAsync();
        }

        _flash = $"Granted access to {granted} user(s)" + (empNew > 0 ? $"; added {empNew} to the employee list." : ".");
        _flashKind = "success";
        _selected.Clear();
        await LoadGrantedAsync();
        _results = null;
    }

    private async Task RemoveAsync(int id)
    {
        await using var db = DbFactory.CreateDbContext();
        var a = await db.AppAccessUsers.FirstOrDefaultAsync(x => x.Id == id);
        if (a is not null) { db.AppAccessUsers.Remove(a); await db.SaveChangesAsync(); }
        _flash = "Access removed."; _flashKind = "success";
        await LoadGrantedAsync();
    }
}
